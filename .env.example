# Copie para ".env" (que NÃO vai para o GitHub) e preencha com os dados do Supabase.

# Supabase → Connect → "Session pooler" (porta 5432). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API → Project URL (opcional por enquanto)
SUPABASE_URL=https://SEU_REF.supabase.co

# Supabase → Project Settings → API Keys → service_role (secreta! só no servidor)
SUPABASE_SERVICE_ROLE_KEY=

# Seu ID de conta no jogo: o Admin Supremo
SUPREME_ADMIN_ID=acc:gabriel

PORT=8080
